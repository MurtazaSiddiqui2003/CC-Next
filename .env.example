# Copy these into Vercel Project Settings > Environment Variables.
# Never commit real values to GitHub.

# A long, unique password for the private /admin dashboard.
ADMIN_PASSWORD=

# A random secret of at least 32 characters used to sign admin sessions.
ADMIN_SESSION_SECRET=

# Fine-grained GitHub token scoped to MurtazaSiddiqui2003/CC-Next with Contents: Read and write.
GITHUB_TOKEN=

# Optional defaults shown here for clarity.
GITHUB_REPOSITORY=MurtazaSiddiqui2003/CC-Next
GITHUB_BRANCH=main
